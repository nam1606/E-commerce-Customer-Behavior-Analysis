# ──────────────────────────────────────────────────────────────
# E-commerce Customer Behavior Analysis — Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and modify as needed:
#   cp .env.example .env

# ── Application Settings ─────────────────────────────────────
APP_TITLE=E-commerce Customer Behavior Analysis
APP_ICON=🛒
DEBUG_MODE=false
LOG_LEVEL=INFO

# ── Data Configuration ───────────────────────────────────────
MAX_UPLOAD_SIZE_MB=500
SAMPLE_DATA_ROWS=50000

# ── Session Construction ─────────────────────────────────────
# Gap (in minutes) that triggers a new session
SESSION_GAP_MINUTES=30
# Users exceeding this many events/day are flagged as bots
BOT_THRESHOLD=1000

# ── Analysis Tuning ──────────────────────────────────────────
COHORT_PERIODS=12
N_CLUSTERS=4
TOP_N_BRANDS=15
MIN_BRAND_EVENTS=100

# ── Visualization ────────────────────────────────────────────
PLOTLY_TEMPLATE=plotly_white
HEATMAP_COLORSCALE=YlOrRd

